import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Backend } from "backend.slint";
import { ChipData, StudentRowData } from "types.slint";
import { Divider, MenuPicker, ProminentButton, RoundedField, SegmentedControl, VCenter } from "controls.slint";
import { SmallButton } from "widgets.slint";
import { ClassPickers } from "pickers.slint";
import { ColorBarsIcon, CrossIcon } from "icons.slint";

// One entry of the legend: a dot in the colour of a category, and its name.
component LegendDot inherits VerticalLayout {
    in property <color> tint;
    in property <string> label;

    spacing: 6px;

    Rectangle {
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: root.tint.with-alpha(0.5);
    }

    Text {
        text: root.label;
        font-size: 12px;
        color: Theme.label;
        horizontal-alignment: center;
    }
}

// A grade (letter above value, tinted by category) with its small remove button. Clicking
// the grade edits it. The lowest grade of a category that is left out of the average is faded
// and struck through.
component GradeChip inherits HorizontalLayout {
    in property <ChipData> chip;
    in property <string> student;
    callback edit();
    callback remove();

    spacing: 2px;

    Rectangle {
        width: max(42px, value-text.preferred-width + 14px);
        height: 36px;
        border-radius: 4px;
        background: Theme.grade-tint(root.chip.kind).with-alpha(0.2);
        opacity: root.chip.dropped ? 0.55 : 1;
        accessible-role: button;
        accessible-label: "Edit grade " + root.chip.value + " for " + root.student;
        accessible-description: root.chip.dropped ? "Left out of the average: the lowest of its category" : "";
        accessible-action-default => {
            root.edit();
        }

        VerticalLayout {
            alignment: center;
            spacing: 1px;

            Text {
                text: root.chip.letter;
                font-size: 11px;
                color: Theme.gray;
                horizontal-alignment: center;
            }

            value-text := Text {
                text: root.chip.value;
                font-size: 15px;
                color: Theme.label;
                horizontal-alignment: center;
            }
        }

        if root.chip.dropped: Rectangle {
            x: (parent.width - value-text.preferred-width) / 2;
            y: 25px;
            width: value-text.preferred-width;
            height: 1px;
            background: Theme.label;
        }

        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.edit();
            }
        }
    }

    Rectangle {
        width: 14px;
        height: 36px;
        accessible-role: button;
        accessible-label: "Remove grade " + root.chip.value + " for " + root.student;
        accessible-action-default => {
            root.remove();
        }

        CrossIcon { }

        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.remove();
            }
        }
    }
}

component StudentRow inherits VerticalLayout {
    in property <StudentRowData> data;
    // Where this row is in the list, and which row was asked to take the keyboard focus.
    in property <int> index;
    in property <int> focus-row;
    in property <int> focus-ticket;
    // The categories don't fit side by side as a segmented control: use a drop-down.
    in property <bool> compact;
    // A score was added: the keyboard goes on to the next student.
    callback submitted();

    spacing: 4px;

    changed focus-ticket => {
        if root.focus-row == root.index {
            field.focus-input();
        }
    }

    function submit() {
        if Backend.add-grade(root.data.id, field.text) {
            field.text = "";
            root.submitted();
        }
    }

    HorizontalLayout {
        spacing: 10px;
        alignment: start;

        Text {
            width: 100px;
            text: root.data.name;
            font-size: 17px;
            font-weight: 600;
            color: Theme.label;
            wrap: word-wrap;
            vertical-alignment: center;
        }

        VCenter {
            width: 60px;
            field := RoundedField {
                placeholder: "Grade";
                accessible-label: "Grade for " + root.data.name;
                text: root.data.draft;
                accepted => {
                    root.submit();
                }
                edited(typed) => {
                    // Digits with one decimal point, a slash for points like 18/20, a plus
                    // for extra credit, or EX for an excused score.
                    let clean = Backend.sanitize-grade(typed);
                    Backend.draft-edited(root.data.id, clean);
                    if clean != typed {
                        self.text = clean;
                    }
                }
            }
        }

        VCenter {
            width: root.compact ? 132px : Backend.category-names.length * 73.4px;

            if !root.compact: SegmentedControl {
                options: Backend.category-names;
                current-index <=> Backend.grade-type;
            }

            if root.compact: MenuPicker {
                options: Backend.category-names;
                current-index <=> Backend.grade-type;
            }
        }

        VCenter {
            ProminentButton {
                text: "Add";
                accessible-label: "Add grade for " + root.data.name;
                clicked => {
                    root.submit();
                }
            }
        }
    }

    if root.data.chips.length > 0: Flickable {
        height: 36px;
        content-width: chips.preferred-width;

        chips := HorizontalLayout {
            spacing: 6px;
            alignment: start;
            for chip in root.data.chips: GradeChip {
                chip: chip;
                student: root.data.name;
                edit => {
                    Backend.edit-grade(chip.id);
                }
                remove => {
                    Backend.delete-grade(chip.id);
                }
            }
        }
    }

    HorizontalLayout {
        padding-left: 100px;
        spacing: 4px;

        if root.data.average != "": Text {
            text: root.data.average;
            font-size: 15px;
            color: Theme.blue;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        SmallButton {
            text: "What do I need?";
            description: "What does " + root.data.name + " need?";
            clicked => {
                Backend.open-needed(root.data.id);
            }
        }

        SmallButton {
            text: "Report Card";
            description: "Report card for " + root.data.name;
            clicked => {
                Backend.open-report(root.data.id);
            }
        }
    }

    Divider { }
}

export component GradesPage inherits Rectangle {
    property <int> focus-row: -1;
    property <int> focus-ticket: 0;
    // A row is as wide as the page, less the padding and the scroll bar. The width of what
    // is left of it after the name, the field and the button is what a segmented control
    // for the categories needs, 73 pixels each. The page's own width is what to go by: a
    // row that grew wider than the window would otherwise keep itself wide.
    property <bool> compact: root.width - 48px < 262px + Backend.category-names.length * 73.4px;

    VerticalLayout {
        spacing: 12px;

        ClassPickers {
            vertical-stretch: 0;
        }

        HorizontalLayout {
            vertical-stretch: 0;
            padding-bottom: 16px;
            spacing: Backend.legend.length > 5 ? 14px : 30px;
            alignment: center;
            for label[kind] in Backend.legend: LegendDot {
                tint: Theme.grade-tint(kind);
                label: label;
            }
        }

        Divider {
            vertical-stretch: 0;
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-bottom: 16px;
                spacing: 12px;
                alignment: start;

                if Backend.rows.length == 0: HorizontalLayout {
                    padding-top: 24px;

                    Text {
                        text: "There are no students in this grade yet. Add some on the Students screen.";
                        font-size: 15px;
                        color: Theme.gray;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                for row[index] in Backend.rows: StudentRow {
                    data: row;
                    index: index;
                    compact: root.compact;
                    focus-row: root.focus-row;
                    focus-ticket: root.focus-ticket;
                    submitted => {
                        root.focus-row = index + 1;
                        root.focus-ticket += 1;
                    }
                }

                if Backend.class-average != "": HorizontalLayout {
                    padding-top: 16px;
                    spacing: 8px;
                    alignment: center;
                    ColorBarsIcon { }

                    Text {
                        text: "Class Average: " + Backend.class-average;
                        font-size: 20px;
                        font-weight: 700;
                        color: Theme.purple;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
