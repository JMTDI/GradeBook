import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Backend } from "backend.slint";
import { StudentItem } from "types.slint";
import { Divider, MenuPicker, ProminentButton, RoundedField, TintedButton, VCenter, WeightSlider } from "controls.slint";
import { DownloadIcon, MinusCircleIcon, UploadIcon } from "icons.slint";

// A row of the student list. Deleting is two steps: reveal the red "Delete" button
// (hover the row and click the minus, or press Delete), then confirm it.
component StudentListRow inherits Rectangle {
    in property <StudentItem> item;
    in property <bool> last;
    in property <bool> revealed;
    callback reveal();
    callback cancel();
    callback remove();

    height: 44px;
    forward-focus: focus;
    accessible-role: list-item;
    accessible-label: root.item.name + ", " + root.item.grade;

    focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Delete || event.text == Key.Backspace {
                if root.revealed {
                    root.remove();
                } else {
                    root.reveal();
                }
                return accept;
            } else if event.text == Key.Escape {
                root.cancel();
                return accept;
            }
            return reject;
        }
    }

    row-touch := TouchArea {
        clicked => {
            root.cancel();
            focus.focus();
        }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 10px;

        Text {
            horizontal-stretch: 1;
            text: root.item.name;
            font-size: 17px;
            color: Theme.label;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            text: root.item.grade;
            font-size: 12px;
            color: Theme.gray;
            vertical-alignment: center;
        }

        Rectangle {
            width: 22px;
            // Faded out rather than hidden, so it stays reachable for assistive tech.
            opacity: !root.revealed && (row-touch.has-hover || minus-touch.has-hover || focus.has-focus) ? 1 : 0;
            accessible-role: button;
            accessible-label: "Delete " + root.item.name;
            accessible-action-default => {
                root.reveal();
            }

            MinusCircleIcon { }

            minus-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.reveal();
                }
            }
        }

        if root.revealed: VCenter {
            width: 72px;

            Rectangle {
                height: 30px;
                border-radius: 7px;
                background: Theme.red;
                accessible-role: button;
                accessible-label: "Confirm delete " + root.item.name;
                accessible-action-default => {
                    root.remove();
                }

                Text {
                    text: "Delete";
                    color: #ffffff;
                    font-size: 15px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.remove();
                    }
                }
            }
        }
    }

    if !root.last: Rectangle {
        x: 16px;
        y: parent.height - self.height;
        width: parent.width - 16px;
        height: 1phx;
        background: Theme.separator;
    }
}

component WeightRow inherits HorizontalLayout {
    in property <string> title;
    in-out property <float> value;
    callback changed();

    spacing: 8px;

    Text {
        width: 100px;
        text: root.title + " Weight";
        font-size: 17px;
        color: Theme.label;
        wrap: word-wrap;
        vertical-alignment: center;
    }

    VCenter {
        WeightSlider {
            value <=> root.value;
            accessible-label: root.title + " weight";
            changed(new-value) => {
                root.changed();
            }
        }
    }

    Text {
        width: 40px;
        text: Math.round(root.value) + "%";
        font-size: 17px;
        color: Theme.label;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

export component SettingsPage inherits Rectangle {
    property <int> new-grade-index: 0;
    property <string> revealed-id;
    property <float> total-weight: Backend.test-weight + Backend.quiz-weight + Backend.homework-weight;

    function add-student() {
        if !Backend.is-blank(name-field.text) {
            Backend.add-student(name-field.text, root.new-grade-index + 1);
            name-field.text = "";
            root.new-grade-index = 0;
        }
    }

    VerticalLayout {
        padding: 16px;
        padding-top: 32px;
        spacing: 16px;

        Text {
            text: "Add Student";
            font-size: 22px;
            color: Theme.label;
        }

        HorizontalLayout {
            spacing: 8px;

            VCenter {
                horizontal-stretch: 1;
                name-field := RoundedField {
                    placeholder: "Student Name";
                    accepted => {
                        root.add-student();
                    }
                }
            }

            VCenter {
                width: 120px;
                horizontal-stretch: 0;
                MenuPicker {
                    options: Backend.grade-level-options;
                    current-index <=> root.new-grade-index;
                }
            }

            VCenter {
                horizontal-stretch: 0;
                ProminentButton {
                    text: "Add";
                    enabled: !Backend.is-blank(name-field.text);
                    clicked => {
                        root.add-student();
                    }
                }
            }
        }

        Divider { }

        Text {
            text: "Students";
            font-size: 17px;
            font-weight: 600;
            color: Theme.label;
        }

        if Backend.students.length == 0: Text {
            text: "No students added yet";
            font-size: 17px;
            color: Theme.gray;
        }

        if Backend.students.length > 0: Rectangle {
            vertical-stretch: 1;
            min-height: 132px;
            background: Theme.grouped-background;
            clip: true;

            ScrollView {
                VerticalLayout {
                    padding: 16px;
                    alignment: start;

                    Rectangle {
                        border-radius: 10px;
                        background: Theme.cell-background;

                        VerticalLayout {
                            for item[index] in Backend.students: StudentListRow {
                                item: item;
                                last: index == Backend.students.length - 1;
                                revealed: root.revealed-id == item.id;
                                reveal => {
                                    root.revealed-id = item.id;
                                }
                                cancel => {
                                    root.revealed-id = "";
                                }
                                remove => {
                                    root.revealed-id = "";
                                    Backend.delete-student(item.id);
                                }
                            }
                        }
                    }
                }
            }
        }

        Divider { }

        Text {
            text: "Assignment Weights";
            font-size: 22px;
            color: Theme.label;
        }

        VerticalLayout {
            spacing: 10px;

            WeightRow {
                title: "Test";
                value <=> Backend.test-weight;
                changed => {
                    Backend.weights-changed();
                }
            }

            WeightRow {
                title: "Quiz";
                value <=> Backend.quiz-weight;
                changed => {
                    Backend.weights-changed();
                }
            }

            WeightRow {
                title: "Homework";
                value <=> Backend.homework-weight;
                changed => {
                    Backend.weights-changed();
                }
            }

            Text {
                text: "Total: " + Math.round(root.total-weight) + "%";
                font-size: 17px;
                font-weight: 700;
                color: root.total-weight == 100 ? Theme.green : Theme.red;
            }
        }

        Divider { }

        HorizontalLayout {
            spacing: 20px;
            alignment: start;

            TintedButton {
                text: "Backup";
                UploadIcon { }

                clicked => {
                    Backend.backup();
                }
            }

            ProminentButton {
                text: "Restore";
                DownloadIcon {
                    tint: #ffffff;
                }

                clicked => {
                    Backend.restore();
                }
            }
        }

        // Shares the leftover height with the list.
        Rectangle {
            vertical-stretch: 1;
        }
    }
}
