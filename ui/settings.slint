import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Backend } from "backend.slint";
import { CategoryRow, NameItem } from "types.slint";
import { Divider, MenuPicker, ProminentButton, RoundedField, TintedButton, VCenter, WeightSlider } from "controls.slint";
import { SmallButton, ToggleSwitch } from "widgets.slint";
import { DownloadIcon, UploadIcon } from "icons.slint";

component SectionTitle inherits Text {
    font-size: 22px;
    color: Theme.label;
}

// A line of small grey text under a title or a control.
component Hint inherits Text {
    font-size: 13px;
    color: Theme.gray;
    wrap: word-wrap;
}

// A category's weight, and whether its lowest score is left out of the average.
component WeightRow inherits VerticalLayout {
    in property <CategoryRow> entry;
    callback changed(float);
    callback drop-toggled(bool);

    spacing: 4px;

    HorizontalLayout {
        spacing: 8px;

        Text {
            width: 100px;
            text: root.entry.name + " Weight";
            font-size: 17px;
            color: Theme.label;
            wrap: word-wrap;
            vertical-alignment: center;
        }

        VCenter {
            slider := WeightSlider {
                value: root.entry.weight;
                accessible-label: root.entry.name + " weight";
                changed(new-value) => {
                    root.changed(new-value);
                }
            }
        }

        Text {
            width: 40px;
            text: Math.round(slider.value) + "%";
            font-size: 17px;
            color: Theme.label;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    HorizontalLayout {
        padding-left: 108px;
        spacing: 10px;

        Hint {
            horizontal-stretch: 1;
            text: "Leave out the lowest " + root.entry.name + " score";
            vertical-alignment: center;
        }

        ToggleSwitch {
            checked: root.entry.drop-lowest;
            accessible-label: "Drop lowest " + root.entry.name;
            toggled(on) => {
                root.drop-toggled(on);
            }
        }
    }
}

// A subject, category or grade level that was added, with what can be done to it.
component NameRow inherits HorizontalLayout {
    in property <NameItem> item;
    in property <bool> editable: true;
    callback rename();
    callback remove();

    spacing: 4px;
    height: 36px;

    Text {
        horizontal-stretch: 1;
        text: root.item.name;
        font-size: 17px;
        color: Theme.label;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        text: root.item.detail;
        font-size: 12px;
        color: Theme.gray;
        vertical-alignment: center;
    }

    if root.editable: VCenter {
        SmallButton {
            text: "Rename";
            description: "Rename " + root.item.name;
            clicked => {
                root.rename();
            }
        }
    }

    VCenter {
        SmallButton {
            text: "Remove";
            tint: Theme.red;
            description: "Remove " + root.item.name;
            clicked => {
                root.remove();
            }
        }
    }
}

// The list under an "add" field.
component NameList inherits Rectangle {
    in property <int> count;

    visible: root.count > 0;
    height: root.count > 0 ? list.preferred-height : 0px;
    border-radius: 10px;
    background: Theme.card-background;

    list := VerticalLayout {
        padding-left: 14px;
        padding-right: 10px;
        padding-top: 4px;
        padding-bottom: 4px;
        @children
    }
}

export component SettingsPage inherits Rectangle {
    // The buttons in the corners take the first 48 pixels. What scrolls starts below them, so
    // that it never slides under them.
    ScrollView {
        y: 48px;
        height: parent.height - 48px;

        VerticalLayout {
            padding: 16px;
            padding-top: 12px;
            padding-bottom: 32px;
            spacing: 16px;
            alignment: start;

            SectionTitle {
                text: "Assignment Weights";
            }

            HorizontalLayout {
                spacing: 10px;

                Text {
                    text: "Weights for";
                    font-size: 17px;
                    color: Theme.label;
                    vertical-alignment: center;
                }

                VCenter {
                    width: 190px;

                    MenuPicker {
                        options: Backend.weight-scope-options;
                        current-index <=> Backend.weight-scope-index;
                        selected(index) => {
                            Backend.weight-scope-changed();
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }
            }

            Hint {
                text: Backend.weight-scope-note;
            }

            VerticalLayout {
                spacing: 10px;

                for entry[index] in Backend.weight-rows: WeightRow {
                    entry: entry;
                    changed(value) => {
                        Backend.weight-changed(index, value);
                    }
                    drop-toggled(on) => {
                        Backend.drop-lowest-changed(index, on);
                    }
                }

                Text {
                    text: "Total: " + Math.round(Backend.weights-total) + "%";
                    font-size: 17px;
                    font-weight: 700;
                    color: Backend.weights-total == 100 ? Theme.green : Theme.red;
                }
            }

            if Backend.weight-scope-own: HorizontalLayout {
                alignment: start;

                TintedButton {
                    text: "Use the Default Weights";
                    clicked => {
                        Backend.reset-scope-weights();
                    }
                }
            }

            Divider { }

            SectionTitle {
                text: "Categories";
            }

            Hint {
                text: "Homework, Test and Quiz are always there. Add your own kinds of scores, such as Project or Participation, and give them a weight above.";
            }

            HorizontalLayout {
                spacing: 8px;

                VCenter {
                    horizontal-stretch: 1;
                    category-field := RoundedField {
                        placeholder: "Category Name";
                        accepted => {
                            if !Backend.is-blank(self.text) && Backend.add-category(self.text) {
                                self.text = "";
                            }
                        }
                    }
                }

                VCenter {
                    ProminentButton {
                        text: "Add";
                        accessible-label: "Add category";
                        enabled: !Backend.is-blank(category-field.text);
                        clicked => {
                            if Backend.add-category(category-field.text) {
                                category-field.text = "";
                            }
                        }
                    }
                }
            }

            NameList {
                count: Backend.custom-categories.length;

                for item[index] in Backend.custom-categories: NameRow {
                    item: item;
                    rename => {
                        Backend.rename-category(index);
                    }
                    remove => {
                        Backend.remove-category(index);
                    }
                }
            }

            Divider { }

            SectionTitle {
                text: "Subjects";
            }

            Hint {
                text: "The usual 20 subjects are always there. Add the ones you teach that aren't.";
            }

            HorizontalLayout {
                spacing: 8px;

                VCenter {
                    horizontal-stretch: 1;
                    subject-field := RoundedField {
                        placeholder: "Subject Name";
                        accepted => {
                            if !Backend.is-blank(self.text) && Backend.add-subject(self.text) {
                                self.text = "";
                            }
                        }
                    }
                }

                VCenter {
                    ProminentButton {
                        text: "Add";
                        accessible-label: "Add subject";
                        enabled: !Backend.is-blank(subject-field.text);
                        clicked => {
                            if Backend.add-subject(subject-field.text) {
                                subject-field.text = "";
                            }
                        }
                    }
                }
            }

            NameList {
                count: Backend.custom-subjects.length;

                for item[index] in Backend.custom-subjects: NameRow {
                    item: item;
                    rename => {
                        Backend.rename-subject(index);
                    }
                    remove => {
                        Backend.remove-subject(index);
                    }
                }
            }

            Divider { }

            SectionTitle {
                text: "Grade Levels";
            }

            Hint {
                text: "Grades 1 to 10 are always there. Add Kindergarten or grades 11 to 20 if you need them.";
            }

            if Backend.addable-level-options.length > 0: HorizontalLayout {
                spacing: 8px;
                alignment: start;

                VCenter {
                    width: 150px;

                    MenuPicker {
                        options: Backend.addable-level-options;
                        current-index <=> Backend.addable-level-index;
                    }
                }

                VCenter {
                    ProminentButton {
                        text: "Add";
                        accessible-label: "Add grade level";
                        clicked => {
                            Backend.add-level();
                        }
                    }
                }
            }

            NameList {
                count: Backend.extra-levels.length;

                for item[index] in Backend.extra-levels: NameRow {
                    item: item;
                    editable: false;
                    remove => {
                        Backend.remove-level(index);
                    }
                }
            }

            Divider { }

            SectionTitle {
                text: "Your Data";
            }

            HorizontalLayout {
                spacing: 20px;
                alignment: start;

                TintedButton {
                    text: "Backup";
                    UploadIcon { }

                    clicked => {
                        Backend.backup();
                    }
                }

                ProminentButton {
                    text: "Restore";
                    DownloadIcon {
                        tint: #ffffff;
                    }

                    clicked => {
                        Backend.restore();
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                TintedButton {
                    text: "Open Data Folder";
                    clicked => {
                        Backend.open-data-folder();
                    }
                }

                TintedButton {
                    text: "Export Scores (CSV)";
                    clicked => {
                        Backend.export-scores();
                    }
                }
            }

            Hint {
                text: Backend.data-folder;
            }

            Hint {
                text: Backend.backups-summary;
            }

            HorizontalLayout {
                alignment: start;

                TintedButton {
                    text: "Start a New School Year";
                    tint: Theme.red;
                    clicked => {
                        Backend.start-new-year();
                    }
                }
            }

            Hint {
                text: "Saves a copy of everything first, then clears every score and moves each student up a grade. You can undo it until you quit.";
            }

            Divider { }

            SectionTitle {
                text: "About";
            }

            Text {
                text: "GradeBook " + Backend.version;
                font-size: 17px;
                color: Theme.label;
            }

            Hint {
                text: "Made with Slint. The Inter typeface is used under the SIL Open Font License.";
            }

            Divider { }

            SectionTitle {
                text: "Updates";
            }

            HorizontalLayout {
                spacing: 10px;

                Text {
                    horizontal-stretch: 1;
                    text: "Look for a new version when GradeBook starts";
                    font-size: 17px;
                    color: Theme.label;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }

                VCenter {
                    ToggleSwitch {
                        checked <=> Backend.check-updates;
                        accessible-label: "Look for updates at start";
                        toggled(on) => {
                            Backend.check-updates-changed();
                        }
                    }
                }
            }

            Hint {
                text: "GradeBook asks GitHub for the number of the newest release each time it starts. It sends nothing about you or your gradebook, and it never installs anything by itself. When this is off, it only looks when you press Check for Updates.";
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                TintedButton {
                    text: "Check for Updates";
                    clicked => {
                        Backend.check-now();
                    }
                }

                if Backend.update-available: ProminentButton {
                    text: "Open the Download Page";
                    clicked => {
                        Backend.open-release-page();
                    }
                }
            }

            Hint {
                text: Backend.update-status;
            }
        }
    }
}
