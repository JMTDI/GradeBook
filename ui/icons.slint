import { Theme } from "theme.slint";

// SF-Symbol-like icons drawn as vector paths so they render identically on every
// platform (no icon font or emoji font needed).

// `gearshape` / `gearshape.fill`
export component GearIcon inherits Path {
    in property <color> tint: Theme.accent;
    in property <bool> filled: false;

    width: 24px;
    height: 24px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: root.filled ? root.tint : transparent;
    fill-rule: evenodd;
    stroke: root.tint;
    stroke-width: 1.5px;
    stroke-line-join: round;
    commands: "M 10.13 4.22 L 10.64 1.89 L 13.36 1.89 L 13.87 4.22 A 8.00 8.00 0 0 1 16.18 5.18 L 18.19 3.89 L 20.11 5.81 L 18.82 7.82 A 8.00 8.00 0 0 1 19.78 10.13 L 22.11 10.64 L 22.11 13.36 L 19.78 13.87 A 8.00 8.00 0 0 1 18.82 16.18 L 20.11 18.19 L 18.19 20.11 L 16.18 18.82 A 8.00 8.00 0 0 1 13.87 19.78 L 13.36 22.11 L 10.64 22.11 L 10.13 19.78 A 8.00 8.00 0 0 1 7.82 18.82 L 5.81 20.11 L 3.89 18.19 L 5.18 16.18 A 8.00 8.00 0 0 1 4.22 13.87 L 1.89 13.36 L 1.89 10.64 L 4.22 10.13 A 8.00 8.00 0 0 1 5.18 7.82 L 3.89 5.81 L 5.81 3.89 L 7.82 5.18 A 8.00 8.00 0 0 1 10.13 4.22 Z M 15.30 12 A 3.30 3.30 0 1 1 8.70 12 A 3.30 3.30 0 1 1 15.30 12 Z";
}

// `chart.bar` / `chart.bar.fill`
export component BarChartIcon inherits Rectangle {
    in property <color> tint: Theme.accent;
    in property <bool> filled: false;

    width: 24px;
    height: 24px;

    for bar[i] in [{ x: 3.5, top: 12.0 }, { x: 9.75, top: 3.5 }, { x: 16.0, top: 8.0 }]: Rectangle {
        x: bar.x * 1px;
        y: bar.top * 1px;
        width: 4.5px;
        height: 20.5px - bar.top * 1px;
        border-radius: 1.2px;
        background: root.filled ? root.tint : transparent;
        border-width: 1.5px;
        border-color: root.tint;
    }
}

// The multi-coloured chart used next to the class average.
export component ColorBarsIcon inherits Rectangle {
    width: 22px;
    height: 22px;
    Rectangle {
        x: 2px;
        y: 11px;
        width: 4.5px;
        height: 9px;
        border-radius: 1.2px;
        background: Theme.blue;
    }
    Rectangle {
        x: 8.75px;
        y: 3px;
        width: 4.5px;
        height: 17px;
        border-radius: 1.2px;
        background: Theme.green;
    }
    Rectangle {
        x: 15.5px;
        y: 7px;
        width: 4.5px;
        height: 13px;
        border-radius: 1.2px;
        background: Theme.orange;
    }
}

// `chevron.up.chevron.down`: the menu-picker indicator.
export component ChevronsIcon inherits Path {
    in property <color> tint: Theme.accent;

    width: 9px;
    height: 14px;
    viewbox-width: 9;
    viewbox-height: 14;
    fill: transparent;
    stroke: root.tint;
    stroke-width: 1.5px;
    stroke-line-cap: round;
    stroke-line-join: round;
    commands: "M 1.2 5.2 L 4.5 1.9 L 7.8 5.2 M 1.2 8.8 L 4.5 12.1 L 7.8 8.8";
}

export component CheckIcon inherits Path {
    in property <color> tint: Theme.label;

    width: 14px;
    height: 12px;
    viewbox-width: 14;
    viewbox-height: 12;
    fill: transparent;
    stroke: root.tint;
    stroke-width: 2px;
    stroke-line-cap: round;
    stroke-line-join: round;
    commands: "M 1.5 6.5 L 5 10 L 12.5 1.8";
}

// The small "✕" next to each grade chip.
export component CrossIcon inherits Path {
    in property <color> tint: Theme.red;

    width: 9px;
    height: 9px;
    viewbox-width: 9;
    viewbox-height: 9;
    fill: transparent;
    stroke: root.tint;
    stroke-width: 1.5px;
    stroke-line-cap: round;
    commands: "M 1 1 L 8 8 M 8 1 L 1 8";
}

// `square.and.arrow.up`
export component UploadIcon inherits Path {
    in property <color> tint: Theme.accent;

    width: 20px;
    height: 20px;
    viewbox-width: 20;
    viewbox-height: 20;
    fill: transparent;
    stroke: root.tint;
    stroke-width: 1.6px;
    stroke-line-cap: round;
    stroke-line-join: round;
    commands: "M 10 12.5 V 2.5 M 6.2 5.8 L 10 2 L 13.8 5.8 M 5.5 8.5 H 5 Q 3.5 8.5 3.5 10 V 15.5 Q 3.5 17 5 17 H 15 Q 16.5 17 16.5 15.5 V 10 Q 16.5 8.5 15 8.5 H 14.5";
}

// `square.and.arrow.down`
export component DownloadIcon inherits Path {
    in property <color> tint: Theme.accent;

    width: 20px;
    height: 20px;
    viewbox-width: 20;
    viewbox-height: 20;
    fill: transparent;
    stroke: root.tint;
    stroke-width: 1.6px;
    stroke-line-cap: round;
    stroke-line-join: round;
    commands: "M 10 2 V 12 M 6.2 8.7 L 10 12.5 L 13.8 8.7 M 5.5 8.5 H 5 Q 3.5 8.5 3.5 10 V 15.5 Q 3.5 17 5 17 H 15 Q 16.5 17 16.5 15.5 V 10 Q 16.5 8.5 15 8.5 H 14.5";
}

// The red `minus.circle.fill` shown on a hovered student row.
export component MinusCircleIcon inherits Rectangle {
    in property <color> tint: Theme.red;

    width: 22px;
    height: 22px;
    border-radius: 11px;
    background: root.tint;
    Rectangle {
        width: 12px;
        height: 2px;
        border-radius: 1px;
        background: #ffffff;
    }
}
