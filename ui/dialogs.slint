import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Backend } from "backend.slint";
import { ReportRowData } from "types.slint";
import { Divider, MenuPicker, ProminentButton, RoundedField, SegmentedControl, TintedButton } from "controls.slint";
import { ModalFrame, RoundedArea } from "widgets.slint";

// A line of small grey text: a hint under a field, or the details under a title.
component Caption inherits Text {
    font-size: 12px;
    color: Theme.gray;
    wrap: word-wrap;
}

// A category chooser: tabs when there are few categories, a menu when there are many.
component CategoryChoice inherits HorizontalLayout {
    in-out property <int> current-index;
    callback selected(int);

    alignment: start;

    if Backend.category-names.length <= 4: SegmentedControl {
        width: Backend.category-names.length * 92px;
        options: Backend.category-names;
        current-index <=> root.current-index;
        selected(index) => {
            root.selected(index);
        }
    }

    if Backend.category-names.length > 4: MenuPicker {
        width: 180px;
        options: Backend.category-names;
        current-index <=> root.current-index;
        selected(index) => {
            root.selected(index);
        }
    }
}

export component EditScoreDialog inherits ModalFrame {
    property <int> kind: Backend.edit-kind;
    property <bool> valid: Backend.is-valid-score(value.text);

    title: "Edit Score";
    card-width: 420px;

    cancel => {
        Backend.close-dialog();
    }
    focus-first => {
        value.focus-input();
    }
    focus-last => {
        cancel-button.focus();
    }

    function save() {
        if root.valid {
            Backend.save-edit-score(value.text, root.kind);
        }
    }

    Caption {
        text: Backend.edit-title;
    }

    value := RoundedField {
        placeholder: "Score";
        text: Backend.edit-value;
        edited(typed) => {
            let clean = Backend.sanitize-grade(typed);
            if clean != typed {
                self.text = clean;
            }
        }
        accepted => {
            root.save();
        }
    }

    Caption {
        text: "A score like 92.5, points like 18/20, +5 for extra credit, or EX for an excused score.";
    }

    CategoryChoice {
        current-index <=> root.kind;
    }

    HorizontalLayout {
        spacing: 8px;

        TintedButton {
            text: "Delete Score";
            tint: Theme.red;
            clicked => {
                Backend.delete-edit-score();
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        cancel-button := TintedButton {
            text: "Cancel";
            clicked => {
                Backend.close-dialog();
            }
        }

        ProminentButton {
            text: "Save";
            enabled: root.valid;
            clicked => {
                root.save();
            }
        }
    }
}

export component EditStudentDialog inherits ModalFrame {
    property <int> level: Backend.student-level;

    title: "Edit Student";
    card-width: 420px;

    cancel => {
        Backend.close-dialog();
    }
    focus-first => {
        name.focus-input();
    }
    focus-last => {
        cancel-button.focus();
    }

    function save() {
        if !Backend.is-blank(name.text) {
            Backend.save-edit-student(name.text, root.level);
        }
    }

    name := RoundedField {
        placeholder: "Name";
        text: Backend.student-name;
        accepted => {
            root.save();
        }
    }

    HorizontalLayout {
        spacing: 10px;

        Text {
            text: "Grade level";
            font-size: 17px;
            color: Theme.label;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        MenuPicker {
            width: 150px;
            options: Backend.grade-level-options;
            current-index <=> root.level;
        }
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: end;

        cancel-button := TintedButton {
            text: "Cancel";
            clicked => {
                Backend.close-dialog();
            }
        }

        ProminentButton {
            text: "Save";
            enabled: !Backend.is-blank(name.text);
            clicked => {
                root.save();
            }
        }
    }
}

export component PasteListDialog inherits ModalFrame {
    property <int> level: Backend.paste-level;
    property <int> count: Backend.count-names(list.text);

    title: "Paste a Class List";
    card-width: 480px;

    cancel => {
        Backend.close-dialog();
    }
    focus-first => {
        list.focus-input();
    }
    focus-last => {
        cancel-button.focus();
    }

    Caption {
        text: "One name per line. Numbers or bullets at the start of a line are ignored, and a column copied from a spreadsheet works too.";
    }

    list := RoundedArea {
        height: 170px;
        placeholder: "Names, one per line";
    }

    HorizontalLayout {
        spacing: 10px;

        Text {
            text: "Grade level";
            font-size: 17px;
            color: Theme.label;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        MenuPicker {
            width: 150px;
            options: Backend.grade-level-options;
            current-index <=> root.level;
        }
    }

    Text {
        text: root.count == 0 ? "No names yet" : (root.count == 1 ? "1 student will be added" : root.count + " students will be added");
        font-size: 13px;
        color: root.count == 0 ? Theme.gray : Theme.label;
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: end;

        cancel-button := TintedButton {
            text: "Cancel";
            clicked => {
                Backend.close-dialog();
            }
        }

        ProminentButton {
            text: "Add Students";
            enabled: root.count > 0;
            clicked => {
                Backend.add-pasted(list.text, root.level);
            }
        }
    }
}

export component NeededDialog inherits ModalFrame {
    title: Backend.needed-title;
    card-width: 480px;

    cancel => {
        Backend.close-dialog();
    }
    focus-first => {
        target.focus();
    }
    focus-last => {
        close-button.focus();
    }

    Caption {
        text: Backend.needed-subtitle;
    }

    HorizontalLayout {
        spacing: 10px;

        Text {
            text: "Average I want";
            font-size: 17px;
            color: Theme.label;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        target := MenuPicker {
            width: 90px;
            options: Backend.needed-targets;
            current-index <=> Backend.needed-target;
            selected(index) => {
                Backend.needed-changed();
            }
        }
    }

    Text {
        text: "The next score is a";
        font-size: 17px;
        color: Theme.label;
    }

    CategoryChoice {
        current-index <=> Backend.needed-kind;
        selected(index) => {
            Backend.needed-changed();
        }
    }

    Rectangle {
        border-radius: 10px;
        background: Theme.accent.with-alpha(0.12);

        VerticalLayout {
            padding: 14px;

            Text {
                text: Backend.needed-result;
                font-size: 16px;
                color: Theme.label;
                wrap: word-wrap;
            }
        }
    }

    HorizontalLayout {
        alignment: end;

        close-button := ProminentButton {
            text: "Close";
            clicked => {
                Backend.close-dialog();
            }
        }
    }
}

// One line of the report card table. The columns share what room there is, so the table fits
// the card on a narrow window too.
component ReportLine inherits HorizontalLayout {
    in property <ReportRowData> data;
    in property <bool> strong: false;

    spacing: 2px;
    height: 30px;

    Text {
        min-width: 70px;
        horizontal-stretch: 2;
        text: root.data.subject;
        font-size: 14px;
        font-weight: root.strong ? 700 : 400;
        color: Theme.label;
        vertical-alignment: center;
        overflow: elide;
    }

    for cell in root.data.cells: Text {
        min-width: 52px;
        horizontal-stretch: 1;
        text: cell;
        font-size: 13px;
        font-weight: root.strong ? 700 : 400;
        color: cell == "—" ? Theme.tertiary-label : Theme.label;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Text {
        min-width: 64px;
        horizontal-stretch: 1.3;
        text: root.data.average;
        font-size: 13px;
        font-weight: 700;
        color: Theme.blue;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component ReportDialog inherits ModalFrame {
    title: Backend.report-title;
    card-width: 680px;

    cancel => {
        Backend.close-dialog();
    }
    focus-first => {
        save-csv.focus();
    }
    focus-last => {
        close-button.focus();
    }

    Caption {
        text: Backend.report-subtitle;
    }

    if Backend.report-rows.length == 0: Text {
        text: "No scores have been entered for this student yet.";
        font-size: 15px;
        color: Theme.gray;
    }

    if Backend.report-rows.length > 0: VerticalLayout {
        spacing: 4px;

        ReportLine {
            data: {
                subject: "Subject",
                cells: ["P1", "P2", "P3", "P4", "P5", "P6"],
                average: "Average"
            };
            strong: true;
        }

        Divider { }

        // Only a long table scrolls: a scroll view around a short one would show a bar.
        if Backend.report-rows.length <= 8: VerticalLayout {
            for row in Backend.report-rows: ReportLine {
                data: row;
            }
        }

        if Backend.report-rows.length > 8: ScrollView {
            height: 240px;

            VerticalLayout {
                for row in Backend.report-rows: ReportLine {
                    data: row;
                }
            }
        }

        Divider { }

        ReportLine {
            data: Backend.report-total;
            strong: true;
        }
    }

    HorizontalLayout {
        spacing: 8px;

        save-csv := TintedButton {
            text: "Save as CSV";
            clicked => {
                Backend.report-save-csv();
            }
        }

        TintedButton {
            text: "Printable Report";
            clicked => {
                Backend.report-open-printable();
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        close-button := ProminentButton {
            text: "Close";
            clicked => {
                Backend.close-dialog();
            }
        }
    }
}

export component RenameDialog inherits ModalFrame {
    title: Backend.rename-title;
